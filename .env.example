# Copy this file to .env and fill in your key. .env is read by server.js only; the browser never sees it.

# Free key from the Vercel dashboard: AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Laya is free on the AI Gateway through 2026-10-31 (the "-free" id stops working after that).
LAYA_MODEL=convaiinnovations/laya-free

# Optional: Jev (paid, not covered by the free tier)
JEV_MODEL=typesafe-ai/jev

# Optional: self-hosted Laya instead of the gateway
# LAYA_BASE_URL=http://localhost:8080
# LAYA_API_KEY=

# Set to 1 to print raw model responses in the server console
DEBUG_AI=0
PORT=3000
